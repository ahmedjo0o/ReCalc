rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    match /users/{userId} {

      // Calculation history: only the Cloud Function (Admin SDK, which
      // bypasses these rules) may create or edit entries. Signed-in users
      // can still read and delete their own history, matching existing
      // "Delete" / "Delete All" behavior in history.html / manage.html.
      match /history/{historyId} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow delete: if request.auth != null && request.auth.uid == userId;
        allow create, update: if false;
      }

      // Favorites are low-risk (just saved names) and stay fully
      // owner-managed from the client, unchanged from before.
      match /favorites/{favId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }
  }
}
